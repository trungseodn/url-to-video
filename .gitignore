# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (strict: never commit secrets!)
.env*
!.env.example

# database & persistent data
data/
*.db
*.db-shm
*.db-wal

# generated & temporary media files (prevent bloated git repo)
public/images/preview/*
public/images/temp/*
public/images/url-video/*
public/images/collages/*
public/images/image-*
public/videos/*
!public/videos/.gitkeep
public/audio/custom/*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
